# 寰途 · 云服务器配置模板
# 复制成 huantu.env，填好下面几项，随代码一起上传到服务器：
#   scp -r <项目目录> root@<公网IP>:/root/huantu
#   ssh root@<公网IP> "bash /root/huantu/deploy/install.sh /root/huantu/deploy/huantu.env"

# 端口（记得在云厂商防火墙/安全组里放行）
HUANTU_PORT=8788

# 必须监听 0.0.0.0，否则外网进不来
HUANTU_BIND_HOST=0.0.0.0

# 公开试用模式
HUANTU_PUBLIC=1

# 不设访问码：任何拿到网址的人都能用。
# 打开它就等于放弃「只有知道口令的人才能用」这层保护，只保留下面两条止损。
HUANTU_PUBLIC_NO_CODE=1

# 止损 1：每个会话最多几次模型调用（一次完整规划 = 2 次）
HUANTU_MAX_CALLS=6

# 止损 2：每个来源 IP 每天最多几次模型调用（0 = 不限）
HUANTU_PUBLIC_IP_DAILY_CALLS=0

# 想改回需要访问码：删掉上面的 HUANTU_PUBLIC_NO_CODE，并设置这一项（至少 12 位）
# HUANTU_ACCESS_CODE=请替换为至少12位随机访问码

# 访客访问用的地址：填公网 IP，或已解析到这台机器的域名。
# 多个用英文逗号分隔；也支持 *.example.com 这种通配后缀。
HUANTU_PUBLIC_HOST=请替换为公网IP或域名

# 模型：在服务器上跑，建议用你自己的中转或官方接口
HUANTU_API_BASE_URL=https://api.yulitongxing.com/v1
HUANTU_MODEL=gpt-6-luna
HUANTU_PROTOCOL=responses
HUANTU_ROLE=developer
HUANTU_API_KEY=请替换为你的密钥

# 启动时顺手验证一次连通性
HUANTU_AUTO_VERIFY=1
